generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomType {
  CHANNEL
  DIRECT
}

model User {
  id                String             @id @default(uuid())
  username          String             @unique @db.VarChar(50)
  passwordHash      String?            @map("password_hash")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  memberships       RoomMembership[]
  messages          Message[]
  createdRooms      Room[]             @relation("CreatedRooms")
  ownedServers      Server[]           @relation("OwnedServers")
  serverMemberships ServerMembership[]

  @@map("users")
}

model Server {
  id          String             @id @default(uuid())
  name        String             @db.VarChar(100)
  slug        String             @unique @db.VarChar(50)
  description String?            @db.VarChar(255)
  iconUrl     String?            @map("icon_url")
  inviteCode  String             @unique @map("invite_code") @db.VarChar(20)
  ownerId     String             @map("owner_id")
  owner       User               @relation("OwnedServers", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  memberships ServerMembership[]
  rooms       Room[]

  @@map("servers")
}

model ServerMembership {
  id       String   @id @default(uuid())
  serverId String   @map("server_id")
  userId   String   @map("user_id")
  role     String   @default("MEMBER") @db.VarChar(20)
  joinedAt DateTime @default(now()) @map("joined_at")
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
  @@map("server_memberships")
}

model Room {
  id          String           @id @default(uuid())
  slug        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  type        RoomType         @default(CHANNEL)
  isPrivate   Boolean          @default(false) @map("is_private")
  inviteCode  String?          @map("invite_code") @db.VarChar(50)
  serverId    String?          @map("server_id")
  server      Server?          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation("CreatedRooms", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  memberships RoomMembership[]
  messages    Message[]

  @@index([serverId])
  @@index([type])
  @@map("rooms")
}

model RoomMembership {
  id       String   @id @default(uuid())
  userId   String
  roomId   String
  joinedAt DateTime @default(now()) @map("joined_at")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([roomId])
  @@map("room_memberships")
}

model Message {
  id        String    @id @default(uuid())
  messageId String    @unique
  text      String    @db.VarChar(2000)
  userId    String?
  roomId    String    @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  room      Room      @relation(fields: [roomId], references: [slug], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([userId, createdAt])
  @@map("messages")
}
