# Redis (Upstash)
REDIS_HOST=your-upstash-redis-host
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your-upstash-redis-password

# Kafka (Aiven)
KAFKA_BROKER=your-kafka-broker.a.aivencloud.com:28225
KAFKA_USER=avnadmin
KAFKA_PASSWORD=your-aiven-kafka-password
KAFKA_CA_CERT=-----BEGIN CERTIFICATE-----\nYOUR_CA_CERT_HERE\n-----END CERTIFICATE-----

# PostgreSQL (Aiven)
DATABASE_URL=postgresql://avnadmin:password@host:port/dbname?sslmode=require

# Server
PORT=5000
