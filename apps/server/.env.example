# Server
NODE_ENV=development
PORT=5000
JWT_SECRET=change-me-to-a-random-32+char-string
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (Aiven)
DATABASE_URL=postgresql://avnadmin:password@host:port/dbname?sslmode=require

# Redis (Upstash)
REDIS_HOST=your-upstash-redis-host
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=your-upstash-redis-password

# Kafka (Aiven)
KAFKA_BROKER=your-kafka-broker.a.aivencloud.com:28225
KAFKA_USER=avnadmin
KAFKA_PASSWORD=your-aiven-kafka-password
KAFKA_CA_CERT=-----BEGIN CERTIFICATE-----\nYOUR_CA_CERT_HERE\n-----END CERTIFICATE-----
KAFKA_CONSUMER_GROUP=vortex-messages

# Chat limits
MESSAGE_MAX_LENGTH=2000
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=10000
